{
  "name": "sony-sound-connect",
  "private": true,
  "version": "1.1.0",
  "description": "Nullpoint — an unofficial desktop/web client for Sony Sound Connect headphones",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "dev:web": "pnpm --filter @ssc/web run dev",
    "dev:desktop": "pnpm --filter @ssc/desktop run dev"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
